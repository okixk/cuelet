#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(/usr/bin/dirname "$0")" && pwd)"
METADATA_PATH="${SCRIPT_DIR}/package-metadata"

if [[ ! -f "${METADATA_PATH}" ]]; then
    echo "Cuelet Installer metadata is missing." >&2
    exit 1
fi

# Generated by build-release-package.sh from verified payload metadata.
# shellcheck source=/dev/null
. "${METADATA_PATH}"

require_value() {
    local name="$1"
    if [[ -z "${!name:-}" ]]; then
        echo "Cuelet Installer metadata is incomplete (${name})." >&2
        exit 1
    fi
}

for name in \
    CUELET_PAYLOAD_LABEL \
    CUELET_TARGET_RELATIVE_PATH \
    CUELET_EXPECTED_BUNDLE_ID \
    CUELET_EXPECTED_EXECUTABLE \
    CUELET_CANDIDATE_VERSION \
    CUELET_CANDIDATE_BUILD; do
    require_value "${name}"
done

TARGET_VOLUME="${3:-/}"
if [[ "${TARGET_VOLUME}" != /* || "${TARGET_VOLUME}" == *".."* ]]; then
    echo "Cuelet Installer received an invalid target volume." >&2
    exit 1
fi
TARGET_PATH="${TARGET_VOLUME%/}${CUELET_TARGET_RELATIVE_PATH}"

if [[ ! -e "${TARGET_PATH}" && ! -L "${TARGET_PATH}" ]]; then
    exit 0
fi
if [[ -L "${TARGET_PATH}" || ! -d "${TARGET_PATH}" ]]; then
    echo "Cannot replace ${CUELET_PAYLOAD_LABEL}: the expected destination is not a regular bundle." >&2
    exit 1
fi

INFO_PLIST="${TARGET_PATH}/Contents/Info.plist"
if [[ ! -f "${INFO_PLIST}" ]]; then
    echo "Cannot replace ${CUELET_PAYLOAD_LABEL}: the existing bundle has no Info.plist." >&2
    exit 1
fi

read_plist() {
    /usr/libexec/PlistBuddy -c "Print :$1" "${INFO_PLIST}" 2>/dev/null || true
}

INSTALLED_ID="$(read_plist CFBundleIdentifier)"
INSTALLED_EXECUTABLE="$(read_plist CFBundleExecutable)"
INSTALLED_VERSION="$(read_plist CFBundleShortVersionString)"
INSTALLED_BUILD="$(read_plist CFBundleVersion)"

if [[ "${INSTALLED_ID}" != "${CUELET_EXPECTED_BUNDLE_ID}" ||
      "${INSTALLED_EXECUTABLE}" != "${CUELET_EXPECTED_EXECUTABLE}" ]]; then
    echo "Cannot replace ${CUELET_PAYLOAD_LABEL}: the destination belongs to another or unrecognized product." >&2
    exit 1
fi

version_compare() {
    local left="$1"
    local right="$2"
    local old_ifs="${IFS}"
    local index length left_value right_value
    local -a left_parts right_parts

    if [[ ! "${left}" =~ ^[0-9]+(\.[0-9]+)*$ ||
          ! "${right}" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
        return 2
    fi
    IFS='.' read -r -a left_parts <<< "${left}"
    IFS='.' read -r -a right_parts <<< "${right}"
    IFS="${old_ifs}"
    length=${#left_parts[@]}
    if (( ${#right_parts[@]} > length )); then
        length=${#right_parts[@]}
    fi
    for ((index = 0; index < length; index++)); do
        left_value="${left_parts[index]:-0}"
        right_value="${right_parts[index]:-0}"
        left_value=$((10#${left_value}))
        right_value=$((10#${right_value}))
        if (( left_value > right_value )); then
            printf '1\n'
            return 0
        fi
        if (( left_value < right_value )); then
            printf '%s\n' '-1'
            return 0
        fi
    done
    printf '0\n'
}

if ! VERSION_ORDER="$(version_compare "${INSTALLED_VERSION}" "${CUELET_CANDIDATE_VERSION}")"; then
    echo "Cannot replace ${CUELET_PAYLOAD_LABEL}: its installed version is not recognized." >&2
    exit 1
fi
if [[ ! "${INSTALLED_BUILD}" =~ ^[0-9]+$ ||
      ! "${CUELET_CANDIDATE_BUILD}" =~ ^[0-9]+$ ]]; then
    echo "Cannot replace ${CUELET_PAYLOAD_LABEL}: its build version is not recognized." >&2
    exit 1
fi

if [[ "${VERSION_ORDER}" == "1" ]] ||
   [[ "${VERSION_ORDER}" == "0" &&
      $((10#${INSTALLED_BUILD})) -gt $((10#${CUELET_CANDIDATE_BUILD})) ]]; then
    echo "A newer ${CUELET_PAYLOAD_LABEL} is already installed. This package will not downgrade it." >&2
    exit 1
fi

exit 0
